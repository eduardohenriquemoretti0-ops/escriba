# ===== Escriba — copie para .env e preencha =====

# Motor padrão: local (offline, sem GPU) | assemblyai (nuvem) | whisperx (GPU)
ESCRIBA_ENGINE=local

# --- Motor local (offline) ---
WHISPER_MODEL=large-v3-turbo  # máquina fraca: small | medium
WHISPER_DEVICE=auto           # auto | cpu | cuda
# Termos que aparecem sempre (empresa, produtos, clientes), separados por vírgula.
# Os nomes dos participantes de cada reunião entram automaticamente.
ESCRIBA_TERMOS=

# --- AssemblyAI (crie a chave gratuita em assemblyai.com) ---
ASSEMBLYAI_API_KEY=

# --- WhisperX (só se for usar o engine whisperx, com GPU NVIDIA) ---
# Token em huggingface.co/settings/tokens + aceite os termos dos modelos
# pyannote/speaker-diarization-3.1 e pyannote/segmentation-3.0
HF_TOKEN=
WHISPERX_MODEL=large-v3

# --- Ata automática (opcional) ---
ANTHROPIC_API_KEY=
ESCRIBA_SUMMARY_MODEL=claude-sonnet-4-6

# --- E-mail: envio da ata e da transcrição (opcional) ---
# Qualquer provedor SMTP. Gmail/Outlook/Proton exigem "senha de app" ou token
# SMTP, não a senha normal da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                    # se vazio, usa SMTP_USER
SMTP_SECURITY=starttls        # starttls (porta 587) | ssl (porta 465) | none (só p/ servidor local)
ESCRIBA_EMAIL_MAX_MB=20       # soma máxima dos anexos de um envio

# --- Ajustes ---
ESCRIBA_LANGUAGE=pt
ESCRIBA_MAX_UPLOAD_MB=6000
