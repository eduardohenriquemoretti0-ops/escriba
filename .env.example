# === escriba — variáveis de ambiente (copie para .env) ===

# --- Transcrição ---
# Motor: local (Faster-Whisper, grátis) | api (provider pago, opcional)
ESCRIBA_TRANSCRIBE_ENGINE=local
# Modelo Faster-Whisper: tiny|base|small|medium|large-v3 (↑ = + preciso, + lento)
ESCRIBA_WHISPER_MODEL=small
# cpu|cuda  e  int8|int8_float16|float16 (int8 é o certo p/ CPU)
ESCRIBA_WHISPER_DEVICE=cpu
ESCRIBA_WHISPER_COMPUTE=int8
# Idioma (vazio = detecção automática); ex.: pt
ESCRIBA_LANGUAGE=pt

# --- Sumarização / ata (opcional) ---
# Gerar ata via Claude? true|false
ESCRIBA_SUMMARY_ENABLED=false
# Chave da API (NUNCA commitar). Também lida de ~/.env / ambiente.
ANTHROPIC_API_KEY=
# Auto-seleção de modelo por tamanho (decisão de arquitetura do escriba)
ESCRIBA_MODEL_SMALL=claude-haiku-5-5
ESCRIBA_MODEL_LARGE=claude-sonnet-5-5
ESCRIBA_SUMMARY_THRESHOLD_CHARS=400000
ESCRIBA_MAX_CHARS=1500000

# --- API / segurança ---
# Token Bearer da API (gere um aleatório). Vazio = auth desligada (só local).
ESCRIBA_API_TOKEN=
# Rate limit: requisições por janela, por IP+endpoint
ESCRIBA_RATELIMIT_MAX=60
ESCRIBA_RATELIMIT_WINDOW_SEC=60
# Tamanho máx. de upload (MB)
ESCRIBA_MAX_UPLOAD_MB=500

# --- Armazenamento ---
ESCRIBA_DATA_DIR=~/escriba/data
# Dias para expurgar jobs/arquivos antigos
ESCRIBA_CLEANUP_DAYS=7
